{
  "name": "jinge-demos",
  "version": "2.0.0",
  "private": true,
  "description": "demos for jinge web framework",
  "keywords": [
    "demo",
    "jinge"
  ],
  "homepage": "https://github.com/jinge-design/jinge-demos#readme",
  "bugs": {
    "url": "https://github.com/jinge-design/jinge-demos/issues"
  },
  "license": "ISC",
  "author": "Yuhang Ge <abeyuhang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinge-design/jinge-demos.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "lint": "tsgo --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview:docs": "lightstatic docs -b /jinge-demos/"
  },
  "dependencies": {
    "jinge": "link:../jinge",
    "jinge-router": "4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "husky": "^9.1.7",
    "jinge-compiler": "link:../jinge-compiler",
    "lightstatic": "^2.1.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "oxlint --type-aware --fix",
      "oxfmt"
    ]
  }
}
