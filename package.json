{
  "name": "jinge-demos",
  "version": "2.0.0",
  "private": true,
  "description": "demos for jinge web framework",
  "keywords": [
    "demo",
    "jinge"
  ],
  "homepage": "https://github.com/jinge-design/jinge-demos#readme",
  "bugs": {
    "url": "https://github.com/jinge-design/jinge-demos/issues"
  },
  "license": "ISC",
  "author": "Yuhang Ge <abeyuhang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinge-design/jinge-demos.git"
  },
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "lint": "tsc --noEmit && oxlint --type-aware && oxfmt --check",
    "lint-fix": "oxlint --type-aware --fix && oxfmt",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview:docs": "lightstatic docs -b /jinge-demos/",
    "test": "pnpm test:e2e",
    "test:e2e": "node test/e2e/run.mjs",
    "test:e2e:build": "node test/e2e/build.mjs"
  },
  "dependencies": {
    "jinge": "^4.2.1",
    "jinge-router": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "bun": "^1.4.4",
    "husky": "^9.1.7",
    "jinge-compiler": "^4.2.1",
    "lightstatic": "^2.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
